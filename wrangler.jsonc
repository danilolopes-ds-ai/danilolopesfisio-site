// Configuração da Cloudflare (Worker só com arquivos estáticos).
// O nome precisa ser igual ao do projeto no painel da Cloudflare.
{
  "name": "danilolopesfisio-site",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "public",
    // Endereço que não existe mostra a página public/404.html
    "not_found_handling": "404-page"
  }
}
